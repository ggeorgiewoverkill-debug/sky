<!DOCTYPE html>
<html lang="bg">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sky Product World — Interactive Product Training</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            display: ['Fredoka', 'Inter', 'system-ui', 'sans-serif'],
            sans: ['Inter', 'system-ui', 'sans-serif'],
          }
        }
      }
    };
  </script>
  <style>
    /* Base typography and smooth overflow protection on mobile and desktop */
    html, body {
      font-family: 'Inter', system-ui, sans-serif;
      overflow-x: hidden;
    }

    .font-arcade {
      font-family: 'Fredoka', 'Inter', system-ui, sans-serif;
    }

    /* Super Mario-inspired brick & ? block textures */
    .mario-brick {
      background-color: #c84b28;
      background-image:
        linear-gradient(335deg, rgba(0, 0, 0, 0.22) 23px, transparent 23px),
        linear-gradient(155deg, rgba(255, 255, 255, 0.16) 23px, transparent 23px),
        linear-gradient(335deg, rgba(0, 0, 0, 0.22) 23px, transparent 23px),
        linear-gradient(155deg, rgba(255, 255, 255, 0.16) 23px, transparent 23px);
      background-size: 40px 20px;
      background-position: 0 0, 0 10px, 20px -10px, 20px 0;
    }

    .question-block {
      background: linear-gradient(145deg, #fde047 0%, #f59e0b 55%, #d97706 100%);
      box-shadow:
        inset 0 3px 0 rgba(255, 255, 255, 0.65),
        inset 0 -3px 0 rgba(120, 53, 15, 0.45),
        0 3px 0 #92400e;
    }

    /* Tactile 3D arcade push-buttons */
    .btn-3d {
      transition: transform 0.08s ease, box-shadow 0.08s ease, background-color 0.15s ease, border-color 0.15s ease;
    }

    .btn-3d:active:not(:disabled) {
      transform: translateY(3px);
    }

    .btn-3d-blue {
      background-color: #0284c7;
      color: #ffffff;
      border: 2px solid #0369a1;
      box-shadow: 0 4px 0 #0c4a6e;
    }

    .btn-3d-blue:hover:not(:disabled) {
      background-color: #0369a1;
    }

    .btn-3d-blue:active:not(:disabled) {
      box-shadow: 0 1px 0 #0c4a6e;
    }

    .btn-3d-green {
      background-color: #16a34a;
      color: #ffffff;
      border: 2px solid #15803d;
      box-shadow: 0 4px 0 #14532d;
    }

    .btn-3d-green:hover:not(:disabled) {
      background-color: #15803d;
    }

    .btn-3d-green:active:not(:disabled) {
      box-shadow: 0 1px 0 #14532d;
    }

    .btn-3d-amber {
      background-color: #f59e0b;
      color: #1e1b18;
      border: 2px solid #b45309;
      box-shadow: 0 4px 0 #78350f;
    }

    .btn-3d-amber:hover:not(:disabled) {
      background-color: #fbbf24;
    }

    .btn-3d-amber:active:not(:disabled) {
      box-shadow: 0 1px 0 #78350f;
    }

    .btn-3d-violet {
      background-color: #7c3aed;
      color: #ffffff;
      border: 2px solid #5b21b6;
      box-shadow: 0 4px 0 #3b0764;
    }

    .btn-3d-violet:hover:not(:disabled) {
      background-color: #6d28d9;
    }

    .btn-3d-violet:active:not(:disabled) {
      box-shadow: 0 1px 0 #3b0764;
    }

    .btn-3d-neutral {
      background-color: #ffffff;
      color: #0f172a;
      border: 2px solid #cbd5e1;
      box-shadow: 0 3px 0 #94a3b8;
    }

    .dark .btn-3d-neutral {
      background-color: #1e293b;
      color: #f8fafc;
      border: 2px solid #475569;
      box-shadow: 0 3px 0 #0f172a;
    }

    .btn-3d-neutral:hover:not(:disabled) {
      border-color: #38bdf8;
    }

    .btn-3d-neutral:active:not(:disabled) {
      box-shadow: 0 1px 0 #64748b;
    }

    /* 3D card flip for Product Flashcards */
    .perspective-1000 {
      perspective: 1100px;
    }

    .preserve-3d {
      transform-style: preserve-3d;
      transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .backface-hidden {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }

    .rotate-y-180 {
      transform: rotateY(180deg);
    }

    @keyframes popIn {
      0% { transform: scale(0.96); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    .animate-pop {
      animation: popIn 0.2s ease-out;
    }
  </style>
</head>
<body class="bg-sky-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen transition-colors duration-200 selection:bg-amber-400 selection:text-slate-950">
  <div id="app" class="min-h-screen flex flex-col w-full max-w-full">
    <!-- Compact Top Arcade HUD -->
    <header class="sticky top-0 z-30 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b-2 border-sky-600 dark:border-sky-800 shadow-sm">
      <div class="max-w-6xl mx-auto px-3 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-2">
        <!-- Brand & Current World Pill -->
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-10 h-10 rounded-xl question-block flex items-center justify-center font-arcade text-xl font-bold text-amber-950 shrink-0 select-none">
            ?
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <h1 id="app-title" class="font-arcade text-base sm:text-xl font-bold tracking-tight text-slate-900 dark:text-white leading-none truncate"></h1>
              <span id="hud-world-pill" class="px-2 py-0.5 rounded-lg text-[11px] font-extrabold bg-rose-500 text-white border border-rose-700"></span>
            </div>
            <p id="app-subtitle" class="text-[11px] sm:text-xs text-slate-600 dark:text-slate-400 mt-0.5 line-clamp-1"></p>
          </div>
        </div>

        <!-- Compact Counters + BG/EN + Theme -->
        <div class="flex items-center flex-wrap gap-1.5 sm:gap-2">
          <div class="flex items-center gap-1 px-2.5 py-1 rounded-xl bg-amber-100 dark:bg-amber-950/60 border border-amber-400 dark:border-amber-700">
            <span class="w-4 h-4 rounded-full bg-amber-400 border border-amber-700 inline-flex items-center justify-center text-[10px] font-black text-amber-950">¢</span>
            <span id="lbl-coins" class="hidden sm:inline text-xs font-bold text-amber-900 dark:text-amber-200"></span>
            <span id="hud-coins" class="text-xs sm:text-sm font-extrabold text-amber-700 dark:text-amber-300 tabular-nums">0</span>
          </div>

          <div class="flex items-center gap-1 px-2.5 py-1 rounded-xl bg-violet-100 dark:bg-violet-950/60 border border-violet-400 dark:border-violet-700">
            <span class="text-xs leading-none text-violet-600 dark:text-violet-300">★</span>
            <span id="lbl-stars" class="hidden sm:inline text-xs font-bold text-violet-900 dark:text-violet-200"></span>
            <span id="hud-stars" class="text-xs sm:text-sm font-extrabold text-violet-700 dark:text-violet-300 tabular-nums">0/18</span>
          </div>

          <div class="flex items-center gap-1 px-2.5 py-1 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 border border-emerald-400 dark:border-emerald-700">
            <span id="lbl-streak" class="hidden sm:inline text-xs font-extrabold text-emerald-800 dark:text-emerald-200"></span>
            <span id="hud-streak" class="text-xs sm:text-sm font-extrabold text-emerald-700 dark:text-emerald-300 tabular-nums">0</span>
          </div>

          <!-- Language Switcher BG / EN -->
          <div class="inline-flex rounded-xl bg-slate-100 dark:bg-slate-800 p-0.5 border border-slate-300 dark:border-slate-700" role="group" aria-label="Language switcher">
            <button id="btn-lang-bg" type="button" onclick="setLanguage('bg')" class="px-2.5 py-1 rounded-lg text-xs font-extrabold transition-all cursor-pointer">
              BG
            </button>
            <button id="btn-lang-en" type="button" onclick="setLanguage('en')" class="px-2.5 py-1 rounded-lg text-xs font-extrabold transition-all cursor-pointer">
              EN
            </button>
          </div>

          <!-- Theme Toggle -->
          <button id="btn-theme" type="button" onclick="toggleTheme()" class="p-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 transition-colors cursor-pointer" aria-label="Toggle theme">
            <svg id="icon-sun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="icon-moon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Single-Column Clean Workspace -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-3 sm:px-6 py-4 sm:py-6 space-y-5">
      <!-- Staged Product Level Buttons (1-1, 1-2, 2-1, 2-2, 3-1, 3-2) -->
      <section class="rounded-3xl bg-white/95 dark:bg-slate-900/95 border-2 border-slate-900 dark:border-slate-700 shadow-sm overflow-hidden">
        <div class="mario-brick px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-2 text-white border-b-2 border-slate-900">
          <h2 id="world-map-title" class="font-arcade text-sm sm:text-base font-bold tracking-wide"></h2>
          <span id="world-map-hint" class="text-[11px] sm:text-xs font-bold bg-black/35 px-2.5 py-1 rounded-lg"></span>
        </div>

        <div id="world-levels-grid" class="p-3.5 sm:p-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5"></div>
      </section>

      <!-- Large 3D Mode Launch Buttons (Open Dedicated Modals) -->
      <section aria-label="Training mode modals" class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
        <button type="button" onclick="openModeModal('blitz')" class="btn-3d btn-3d-blue rounded-2xl p-4 text-left flex items-center gap-3.5 cursor-pointer">
          <div id="launch-art-blitz" class="w-14 h-11 rounded-xl bg-white text-slate-900 border border-sky-900/20 flex items-center justify-center shrink-0 overflow-hidden"></div>
          <div class="min-w-0">
            <div class="font-arcade text-base sm:text-lg font-bold leading-tight" id="launch-blitz-title"></div>
            <div class="text-xs text-sky-100 font-medium mt-0.5 line-clamp-2" id="launch-blitz-sub"></div>
          </div>
        </button>

        <button type="button" onclick="openModeModal('match')" class="btn-3d btn-3d-green rounded-2xl p-4 text-left flex items-center gap-3.5 cursor-pointer">
          <div id="launch-art-match" class="w-14 h-11 rounded-xl bg-white text-slate-900 border border-emerald-900/20 flex items-center justify-center shrink-0 overflow-hidden"></div>
          <div class="min-w-0">
            <div class="font-arcade text-base sm:text-lg font-bold leading-tight" id="launch-match-title"></div>
            <div class="text-xs text-emerald-100 font-medium mt-0.5 line-clamp-2" id="launch-match-sub"></div>
          </div>
        </button>

        <button type="button" onclick="openModeModal('flashcards')" class="btn-3d btn-3d-violet rounded-2xl p-4 text-left flex items-center gap-3.5 cursor-pointer">
          <div id="launch-art-flashcards" class="w-14 h-11 rounded-xl bg-white text-slate-900 border border-violet-900/20 flex items-center justify-center shrink-0 overflow-hidden"></div>
          <div class="min-w-0">
            <div class="font-arcade text-base sm:text-lg font-bold leading-tight" id="launch-flashcards-title"></div>
            <div class="text-xs text-violet-100 font-medium mt-0.5 line-clamp-2" id="launch-flashcards-sub"></div>
          </div>
        </button>
      </section>

      <!-- Non-blocking Status Banner -->
      <div id="status-banner" class="hidden px-4 py-3 rounded-2xl text-sm font-bold border-2 flex items-center justify-between gap-3 animate-pop">
        <span id="status-banner-text"></span>
        <button type="button" onclick="hideBanner()" class="px-2.5 py-1 rounded-lg bg-black/10 hover:bg-black/20 text-xs font-extrabold cursor-pointer">✕</button>
      </div>
    </main>

    <!-- DEDICATED MODAL WINDOW FOR LEVELS & MODES -->
    <div id="activity-modal" class="hidden fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-sm p-2.5 sm:p-5 overflow-y-auto flex items-start sm:items-center justify-center" role="dialog" aria-modal="true" aria-labelledby="modal-window-title" onclick="handleBackdropClick(event)">
      <div class="w-full max-w-3xl rounded-3xl bg-sky-50 dark:bg-slate-900 border-2 border-slate-900 dark:border-slate-700 shadow-2xl overflow-hidden animate-pop my-auto" onclick="event.stopPropagation()">
        <!-- Modal Header with Illustration Accent & Close/Back Button -->
        <div class="mario-brick px-4 sm:px-5 py-3 flex items-center justify-between gap-3 text-white border-b-2 border-slate-900">
          <div class="flex items-center gap-3 min-w-0">
            <div id="modal-header-art" class="w-12 h-10 rounded-xl bg-white text-slate-900 border border-slate-900 flex items-center justify-center shrink-0 overflow-hidden"></div>
            <div class="min-w-0">
              <div id="modal-window-kicker" class="text-[10px] sm:text-[11px] font-extrabold uppercase tracking-wider text-amber-200 truncate"></div>
              <h2 id="modal-window-title" class="font-arcade text-base sm:text-xl font-bold leading-tight truncate"></h2>
            </div>
          </div>
          <button id="btn-modal-close" type="button" onclick="closeActivityModal()" class="btn-3d btn-3d-amber rounded-xl px-3.5 py-2 text-xs sm:text-sm font-extrabold shrink-0 cursor-pointer">
            ← <span id="btn-modal-close-label"></span>
          </button>
        </div>

        <!-- Modal Body -->
        <div class="p-3.5 sm:p-6 max-h-[82vh] overflow-y-auto space-y-4">
          <!-- MODE 1: PRODUCT BLITZ -->
          <section id="view-blitz" class="hidden space-y-4">
            <div class="bg-white dark:bg-slate-950/70 rounded-2xl p-3.5 sm:p-4 border-2 border-slate-200 dark:border-slate-800">
              <div class="flex items-center justify-between gap-3 mb-2.5">
                <div class="min-w-0">
                  <span id="blitz-level-badge" class="inline-block px-2.5 py-0.5 rounded-lg text-[11px] font-extrabold uppercase bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300 border border-amber-400"></span>
                  <h3 id="blitz-heading" class="font-arcade text-base sm:text-lg font-bold text-slate-900 dark:text-white mt-1"></h3>
                </div>

                <div class="flex items-center gap-2.5 shrink-0">
                  <div class="text-right hidden sm:block">
                    <div id="blitz-speed-lbl" class="text-[10px] font-extrabold uppercase text-slate-400"></div>
                    <div id="blitz-speed-val" class="text-xs font-extrabold text-emerald-600 dark:text-emerald-400 tabular-nums"></div>
                  </div>
                  <div class="w-14 h-12 rounded-xl bg-slate-900 text-amber-300 border border-slate-700 flex flex-col items-center justify-center">
                    <span id="blitz-timer" class="font-arcade text-base font-bold tabular-nums leading-none">20s</span>
                    <span id="blitz-timer-sub" class="text-[9px] font-bold uppercase text-amber-200/80 mt-0.5"></span>
                  </div>
                </div>
              </div>

              <div class="w-full h-2.5 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
                <div id="blitz-timer-bar" class="h-full bg-gradient-to-r from-amber-400 via-emerald-500 to-sky-500 transition-all duration-300 rounded-full" style="width: 100%;"></div>
              </div>
            </div>

            <!-- Question Card -->
            <div id="blitz-card" class="bg-white dark:bg-slate-950/70 rounded-2xl p-4 sm:p-5 border-2 border-slate-200 dark:border-slate-800 space-y-4">
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <span id="blitz-topic-tag" class="px-3 py-0.5 rounded-lg text-xs font-extrabold bg-sky-100 text-sky-900 dark:bg-sky-950 dark:text-sky-200 border border-sky-400"></span>
                <span id="blitz-progress-lbl" class="text-xs font-extrabold text-slate-500 dark:text-slate-400 tabular-nums"></span>
              </div>

              <div class="flex flex-col sm:flex-row gap-3.5 items-center rounded-2xl p-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
                <div id="blitz-product-art" class="w-28 h-20 rounded-xl bg-white dark:bg-slate-950 border border-sky-200 dark:border-sky-800 flex items-center justify-center p-1.5 shrink-0 overflow-hidden"></div>
                <div class="space-y-1 text-center sm:text-left">
                  <div id="blitz-art-caption" class="text-[10px] font-extrabold uppercase tracking-wider text-sky-700 dark:text-sky-300"></div>
                  <p id="blitz-question" class="text-base sm:text-lg font-bold text-slate-900 dark:text-white leading-snug"></p>
                </div>
              </div>

              <!-- Answer Buttons -->
              <div id="blitz-options" class="grid grid-cols-1 gap-2.5"></div>

              <!-- Feedback -->
              <div id="blitz-feedback" class="hidden rounded-2xl p-3.5 border-2 animate-pop">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <div id="blitz-feedback-title" class="font-arcade text-sm sm:text-base font-bold mb-0.5"></div>
                    <p id="blitz-feedback-text" class="text-xs sm:text-sm leading-relaxed font-medium"></p>
                  </div>
                  <span id="blitz-coins-earned" class="px-2.5 py-1 rounded-lg text-xs font-extrabold whitespace-nowrap"></span>
                </div>
              </div>

              <!-- Bottom Controls -->
              <div class="flex flex-wrap items-center justify-between gap-2.5 pt-2 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="replayCurrentLevelBlitz()" class="btn-3d btn-3d-neutral rounded-xl px-4 py-2.5 text-xs sm:text-sm font-extrabold cursor-pointer">
                  <span id="btn-blitz-replay"></span>
                </button>

                <button id="btn-blitz-next" type="button" onclick="nextBlitzQuestion()" class="hidden btn-3d btn-3d-green rounded-xl px-5 py-2.5 text-xs sm:text-sm font-extrabold cursor-pointer">
                  <span id="btn-blitz-next-label"></span> →
                </button>
              </div>
            </div>

            <!-- Level Clear Card -->
            <div id="blitz-level-clear" class="hidden bg-white dark:bg-slate-950/70 rounded-2xl p-6 border-2 border-slate-200 dark:border-slate-800 text-center space-y-4 animate-pop">
              <div class="w-14 h-14 mx-auto rounded-2xl question-block flex items-center justify-center font-arcade text-2xl font-bold text-amber-950">
                ★
              </div>
              <div>
                <h3 id="level-clear-title" class="font-arcade text-xl sm:text-2xl font-bold text-slate-900 dark:text-white"></h3>
                <p id="level-clear-sub" class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1 max-w-md mx-auto"></p>
              </div>
              <div id="level-clear-stars" class="flex justify-center gap-1.5 text-2xl sm:text-3xl text-amber-500"></div>
              <div class="flex flex-wrap items-center justify-center gap-2.5 pt-1">
                <button type="button" onclick="replayCurrentLevelBlitz()" class="btn-3d btn-3d-neutral rounded-xl px-4 py-2.5 text-xs sm:text-sm font-extrabold cursor-pointer">
                  <span id="btn-level-replay"></span>
                </button>
                <button id="btn-next-world" type="button" onclick="goToNextProductLevel()" class="btn-3d btn-3d-amber rounded-xl px-5 py-2.5 text-xs sm:text-sm font-extrabold cursor-pointer">
                  <span id="btn-next-world-label"></span> →
                </button>
              </div>
            </div>
          </section>

          <!-- MODE 2: MATCH PRODUCT TO NEED -->
          <section id="view-match" class="hidden space-y-4">
            <div class="bg-white dark:bg-slate-950/70 rounded-2xl p-4 sm:p-5 border-2 border-slate-200 dark:border-slate-800 space-y-4">
              <div class="flex items-center justify-between gap-2">
                <span id="match-level-pill" class="px-3 py-0.5 rounded-lg text-xs font-extrabold bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-200 border border-emerald-400"></span>
                <span id="match-counter" class="text-xs font-extrabold text-slate-500 dark:text-slate-400 tabular-nums"></span>
              </div>

              <div class="flex flex-col sm:flex-row gap-3.5 items-center rounded-2xl p-3.5 bg-sky-50 dark:bg-slate-900 border border-sky-200 dark:border-sky-800">
                <div id="match-product-art" class="w-28 h-20 rounded-xl bg-white dark:bg-slate-950 border border-sky-200 dark:border-sky-800 flex items-center justify-center p-1.5 shrink-0 overflow-hidden"></div>
                <div class="space-y-1 text-center sm:text-left">
                  <div id="match-customer-lbl" class="text-[11px] font-extrabold uppercase tracking-wider text-sky-700 dark:text-sky-300"></div>
                  <p id="match-quote" class="text-base sm:text-lg font-bold text-slate-900 dark:text-white leading-snug"></p>
                  <p id="match-clue" class="text-xs font-medium text-slate-600 dark:text-slate-300"></p>
                </div>
              </div>

              <h3 id="match-prompt" class="font-arcade text-base sm:text-lg font-bold text-slate-900 dark:text-white"></h3>

              <div id="match-options" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5"></div>

              <div id="match-feedback" class="hidden rounded-2xl p-3.5 border-2 animate-pop">
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <div id="match-feedback-title" class="font-arcade text-sm sm:text-base font-bold mb-0.5"></div>
                    <p id="match-feedback-text" class="text-xs sm:text-sm leading-relaxed font-medium"></p>
                  </div>
                  <span id="match-coins-badge" class="px-2.5 py-1 rounded-lg text-xs font-extrabold whitespace-nowrap"></span>
                </div>
              </div>

